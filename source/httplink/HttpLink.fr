/*
 * To modify the Default HTTP Links rendition type (kFPO or kOriginal),
 * use ILinkFacade::SetHTTPLinksDefaultRenditionType
 */

/*
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kHttpLinkPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kHttpLinkCurrentMajorFormatNumber, kHttpLinkCurrentMinorFormatNumber,
	{ kInDesignProduct, kInCopyProduct, kInDesignServerProduct },
	{ kWildFS },
	kModelPlugIn,
	kHttpLinkVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kHttpLinkCompanyValue,			// Company name
	kHttpLinkMissingPluginURLValue,	// URL 
	kHttpLinkMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
    
     Class
     {
          kHttpLnkLinkResourceProviderBoss,
          kInvalidClass,
          {
               IID_IK2SERVICEPROVIDER,                kHTTPLinkSubsystemObjectProviderImpl,
               IID_IHTTPLINKSUBSYSTEMOBJECTFACTORY,   kHttpLnkLinkResourceFactoryImpl,
          }
     },
     
     Class
     {
          kHttpLnkLinkResourceServerHelperBoss,
          kHTTPAssetLinkResourceServerHelperBoss,
          {
               IID_IHTTPLINKRESOURCESERVERAPIWRAPPER,    kHttpLnkResourceServerAPIWrapperImpl,
          }
     },
     
     Class
     {
          kHttpLnkLinkResourceHelperBoss,
          kHTTPAssetLinkResourceHelperBoss,
          {
               IID_IHTTPLINKRESOURCECONNECTION,           kHttpLnkLinkResourceConnectionImpl,
               IID_IHTTPLINKRESOURCESTATEBATCHUPDATER,    kHttpLnkLinkResourceStateBatchUpdaterImpl,
          }
     },
     
     Class
     {
          kHttpLnkLinkResourceHandlerBoss,
          kHTTPAssetLinkResourceHandlerBoss,
          {
               IID_ILINKRESOURCEHANDLER,                kHttpLnkLinkResourceHandlerImpl,
               IID_ILINKRESOURCEHELPERHANDLER,          kHttpLnkLinkResourceHelperHandlerImpl,
          }
     },


    Class
    {
        kHttpLnkLinkResourceStateUpdaterBoss,
        kInvalidClass,
        {
            IID_ILINKRESOURCESTATEUPDATER,            kHttpLnkLinkResourceStateUpdaterImpl,
        }
    },


    /** Adds the HttpLink scripting surface. Lives in the model plug-in so that
        ExtendScript, UXP and InDesign Server all reach it -- Server never loads
        a UI plug-in.
    */
    Class
    {
        kHttpLnkScriptProviderBoss,
        kBaseScriptProviderBoss,
        {
            IID_ISCRIPTPROVIDER, kHttpLnkScriptProviderImpl,
        }
    },

    /** Extra rows in the Links panel's Link Info pane. One service-provider boss
        per row; InDesign walks the kLinkInfoService registry and asks each for a
        label and a value.
    */
    Class
    {
        kHttpLnkURLInfoProviderBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kLinkInfoServiceImpl,
            IID_ILINKINFOPROVIDER,  kHttpLnkURLInfoProviderImpl,
        }
    },

    Class
    {
        kHttpLnkStatusInfoProviderBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kLinkInfoServiceImpl,
            IID_ILINKINFOPROVIDER,  kHttpLnkStatusInfoProviderImpl,
        }
    },

    Class
    {
        kHttpLnkStampInfoProviderBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kLinkInfoServiceImpl,
            IID_ILINKINFOPROVIDER,  kHttpLnkStampInfoProviderImpl,
        }
    },

}}};

