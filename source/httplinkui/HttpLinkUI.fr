/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kHttpLinkUIPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kHttpLinkUICurrentMajorFormatNumber, kHttpLinkUICurrentMinorFormatNumber,
	{ kInDesignProduct, kInCopyProduct },
	{ kWildFS },
	kUIPlugIn,
	kHttpLinkUIVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kHttpLinkUICompanyValue,			// Company name
	kHttpLinkUIMissingPluginURLValue,	// URL 
	kHttpLinkUIMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{

	/*
	 * This boss class supports two interfaces:
	 * IActionComponent and IPMPersist.
     *
	 * 
	 * @ingroup httplinkui.sdk
	 */
	Class
	{
		kHttpLinkUIActionComponentBoss,
		kInvalidClass,
		{
			// Handle the actions from the menu.
			IID_IACTIONCOMPONENT, kHttpLinkUIActionComponentImpl,
			// Persist the state of the menu across application instantiation. Implementation provided by the API.
			IID_IPMPERSIST, kPMPersistImpl
		}
	},

    /*
	 * This boss class inherits from an API panel boss class, and
	 * adds an interface to control a pop-up menu on the panel.
	 * The implementation for this interface is provided by the API.
     *
	 * 
	 * @ingroup httplinkui.sdk
	 */
	Class
	{
		kHttpLinkUIPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			/*
			 * The plug-in's implementation of ITextControlData with an exotic IID of IID_IPANELMENUDATA.
			 * Implementation provided by the API.
			 */
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
            IID_IOBSERVER, kHttpLinkUIObserverImpl,
		}
	},
    
    /*
     * This boss class inherits from buttonWidget, and
     * adds an interface to get updates on placeButton
     *
     * @ingroup httplinkui.sdk
     */
    Class
    {
        kPlaceButtonBoss,
        kButtonWidgetBoss,
        {
            IID_IOBSERVER, kHttpLinkUIPlaceButtonObserverImpl,
        }
    },
    


    /*
     * The "Relink from Web" modal dialog. All dialogs must implement
     * IDialogController; ours seeds the URL field, validates the typed URL,
     * and performs the relink on OK.
     *
     * @ingroup httplinkui.sdk
     */
    Class
    {
        kHttpLinkUIRelinkDialogBoss,
        kDialogBoss,
        {
            IID_IDIALOGCONTROLLER, kHttpLinkUIRelinkDialogControllerImpl,
        }
    },

    /** Extends the layout widget's drop handling so a URL dragged in from a
        browser is accepted and placed. kLayoutDDTargHelperProviderImpl is the
        SDK-provided service that hangs this off the layout rather than off one
        of our own panels.
    */
    Class
    {
        kHttpLinkUIDropTargetProviderBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER,             kLayoutDDTargHelperProviderImpl,
            IID_IDRAGDROPTARGETFLAVORHELPER,    kHttpLinkUIDDTargetFlavorHelperImpl,
        }
    },

}}};

