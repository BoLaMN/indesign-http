};

/*
 * "Relink from Web" dialog definition.
 * Content column (label + URL field) on the left, OK/Cancel stacked on the
 * right, following the standard InDesign dialog layout (see basicdialog SDK
 * sample).
 */
resource HttpLinkUIRelinkDialogWidget (kSDKDefDialogResourceID + index_enUS)
{
	__FILE__, __LINE__,
	kHttpLinkUIRelinkDialogWidgetID,	// WidgetID
	kPMRsrcID_None,						// RsrcID
	kBindNone,							// Binding
	Frame(0,0,500,88)					// Frame (l,t,r,b)
	kTrue, kTrue,						// Visible, Enabled
	kHttpLinkUIRelinkDialogTitleKey,	// Dialog name
	{
		EVEGenericPanelWidget
		(
			kInvalidWidgetID,	// WidgetId
			0,0,				// RsrcId
			kBindNone,			// Frame binding
			Frame(0,0,380,60)	// Frame
			kTrue,				// Visible
			kTrue,				// Enabled
			kEVEAlignFill | kEVERegularSpaceAfter | kEVEArrangeChildrenInColumn | kEVEChildAlignLeft
			{
				EVEStaticTextWidget
				(
					kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindNone,
					Frame(0,0,380,16)					// Frame
					kTrue, kTrue,						// Visible, Enabled
					kAlignLeft, kDontEllipsize, kTrue,	// Alignment, Ellipsize, Convert ampersands
					"AssetURL",
					kHttpLinkUIRelinkURLEditWidgetID,	// WidgetID this text widget is connected to
					kEVEAlignLeft | kEVEVerySmallSpaceAfter
				),

				EVETextEditBoxWidget
				(
					kHttpLinkUIRelinkURLEditWidgetID,	// WidgetID
					kSysEditBoxPMRsrcId,				// RsrcID
					kBindNone,							// Binding
					Frame(0,0,380,21)					// Frame (l,t,r,b)
					kTrue, kTrue,						// Visible, Enabled
					0,									// Nudge control (0 = none)
					1,									// Small nudge amount
					5,									// Large nudge amount
					0,									// Max # chars (0 = no limit)
					kFalse,								// Read only
					kFalse,								// Notify every keystroke
					kFalse,								// Range checking enabled
					kTrue,								// Blank allowed
					0, 0,								// Upper/lower bounds
					"https://",							// Initial text
					kEVEAlignFill | kEVESmallSpaceAfter,
				),
			}
		),

		EVEGenericPanelWidget
		(
			kInvalidWidgetID,	// WidgetId
			0,0,				// RsrcId
			kBindNone,			// Frame binding
			Frame(0,0,80,60)	// Frame
			kTrue,				// Visible
			kTrue,				// Enabled
			kEVEAlignLeft | kEVELargeSpaceAfter | kEVEArrangeChildrenInColumn
			{
				EVEDefaultButtonWidget
				(
					kOKButtonWidgetID,		// WidgetID
					kSysButtonPMRsrcId,		// RsrcID
					kBindNone,				// Binding
					Frame(0,0,0,0)			// Frame (l,t,r,b)
					kTrue, kTrue,			// Visible, Enabled
					kSDKDefOKButtonApplicationKey,	// Button text
					kEVEAlignFill | kEVERegularSpaceAfter,
				),
				EVECancelButtonWidget
				(
					kCancelButton_WidgetID,	// WidgetID
					kSysButtonPMRsrcId,		// RsrcID
					kBindNone,				// Binding
					Frame(0,0,0,0)			// Frame (l,t,r,b)
					kTrue, kTrue,			// Visible, Enabled
					kSDKDefCancelButtonApplicationKey,	// Button name
					kTrue,					// Change to Reset on option-click.
					kEVEAlignFill | kEVERegularSpaceAfter,
				),
			}
		),
	},

	kEVEArrangeChildrenInRow | kEVERegularMargin,
};

/*  
 * PanelList definition.
 */
resource PanelList (kSDKDefPanelResourceID)
{
	{
		// 1st panel in the list
		kSDKDefPanelResourceID,		// Resource ID for this panel (use SDK default rsrc ID)
		kHttpLinkUIPluginID,			// ID of plug-in that owns this panel
		kIsResizable,
		kHttpLinkUIPanelWidgetActionID,	// Action ID to show/hide the panel
		kHttpLinkUIPanelTitleKey,	// Shows up in the Window list.
		"",							// Alternate menu path of the form "Main:Foo" if you want your palette menu item in a second place
		0.0,						// Alternate Menu position Alternate Menu position for determining menu order
		0,0,						// Rsrc ID, Plugin ID for a PNG icon resource to use for this palette
		c_Panel
	}
};

/* 
 * PanelView definition.
 * Note: it is not necessary to use EVE for panels.
 * The view is not currently localised: therefore, it can reside here.
 * However, if you wish to localise it, it is recommended to locate it in one of
 * the localised framework resource files (i.e. HttpLinkUI_enUS.fr etc.).
 */
resource HttpLinkUIPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,					// Localization macro
	kHttpLinkUIPanelWidgetID,					// WidgetID
	kPMRsrcID_None,						// RsrcID
	kBindNone,							// Binding (0=none)
	Frame(0, 0, 330, 205),				// Frame: left, top, right, bottom.
	kTrue, kTrue,						// Visible, Enabled
	kFalse,								// Erase background
	kInterfacePaletteFill,				// Erase to color
	kFalse,								// Draw dropshadow
	kHttpLinkUIPanelTitleKey,					// Panel name
	{
        EVEGenericPanelWidget
        (
             kInvalidWidgetID,    // WidgetId
             0,0,                // RsrcId
             kBindLeft | kBindRight,                        // Frame binding
             Frame(0,0,320,0),                  // Frame (width is EVE minimum width)
             kTrue,                            // Visible
             kTrue,
             kEVEAlignFill | kEVEArrangeChildrenInColumn | kEVEChildAlignLeft
             {
                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,16)      // Frame
                      kTrue, kTrue,                     // Visible, Enabled,
                      kAlignLeft, kDontEllipsize, kTrue,      //Alignment, Ellipsize, Convert ampersands
                      "AssetURL",
                      kURLEditWidgetID,            // WidgetID this textwidget is connected to, 0 if none.
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),


                 EVETextEditBoxWidget
                 (
                      kURLEditWidgetID,                 // WidgetID
                      kSysEditBoxPMRsrcId,              // RsrcID
                      kBindLeft | kBindRight,           // Binding
                      Frame(0,0,320,21)                 // Frame (l,t,r,b)
                      kTrue, kTrue,                     // Visible, Enabled
                      0,                                // Nudge control (0 = none)
                      1,                                // Small nudge amount
                      5,                                // Large nudge amount
                      0,                                // Max # chars (0 = no limit)
                      kFalse,                           // Read only
                      kFalse,                           // Notify every keystroke
                      kFalse,                           // Range checking enabled
                      kTrue,                            // Blank allowed
                      0, 0,                             // Upper/lower bounds
                      "https://",                       // Initial text
                      kEVEAlignFill | kEVESmallSpaceAfter,
                  ),

                 PlaceButtonBoss
                 (
                      kPlaceURLButtonWidgetID,
                      kSysButtonPMRsrcId,                // RsrcId
                      kBindLeft | kBindRight,
                      Frame(0,0,320,22),         // Frame
                      kTrue, kTrue,                            // Visible, Enabled
                      "PlaceURL",
                      kEVEAlignFill | kEVELargeSpaceAfter,
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIDragHintKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVELargeSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsTitleKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsRasterKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsRaster2Key,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsVectorKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsInDesignKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVEVerySmallSpaceAfter
                  ),

                 EVEStaticTextWidget
                 (
                      kInvalidWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight,
                      Frame(0,0,320,14)
                      kTrue, kTrue,
                      kAlignLeft, kDontEllipsize, kTrue,
                      kHttpLinkUIExtsTextKey,
                      kInvalidWidgetID,
                      kEVEAlignLeft | kEVENoSpaceAfter
                  ),

             }
        )
	}

	kHttpLinkUIInternalPopupMenuNameKey,		// Popup menu name (internal)
    kEVEArrangeChildrenInRow | kEVESmallMargin,
};

