/*  
 * Menu definition.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// The About sub-menu item for this plug-in.
		kHttpLinkUIAboutActionID,			// ActionID (kInvalidActionID for positional entries)
		kHttpLinkUIAboutMenuPath,			// Menu Path.
		kSDKDefAlphabeticPosition,											// Menu Position.
		kSDKDefIsNotDynamicMenuFlag,										// kSDKDefIsNotDynamicMenuFlag or kSDKDefIsDynamicMenuFlag

		// Separator for the popup menu on the panel
		kHttpLinkUISeparator1ActionID,
		kHttpLinkUIInternalPopupMenuNameKey kSDKDefDelimiterAndSeparatorPath,	// :- to mark an item as a separator.
		kHttpLinkUISeparator1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// About this plug-in sub-menu for the popup menu on the panel
		kHttpLinkUIPopupAboutThisActionID,
		kHttpLinkUITargetMenuPath
		kHttpLinkUIAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Relink from Web..." next to InDesign's own Relink commands, in both
		// the Links panel flyout and the right-click menu on a link row.
		kHttpLinkUIRelinkFromWebActionID,
		kHttpLinkUIRelinkPopupMenuPath,
		kRelinkMenuPosition+0.2,
		kSDKDefIsNotDynamicMenuFlag,

		kHttpLinkUIRelinkFromWebActionID,
		kHttpLinkUIRelinkContextMenuPath,
		kRelinkMenuPosition+0.2,
		kSDKDefIsNotDynamicMenuFlag,
        
	}
};

/* 
 * Action definition.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kHttpLinkUIActionComponentBoss, 		// ClassID of boss class that implements the ActionID.
		kHttpLinkUIAboutActionID,	// ActionID.
		kHttpLinkUIAboutMenuKey,	// Sub-menu string.
		kOtherActionArea,				// Area name (see ActionDefs.h).
		kNormalAction,					// Type of action (see ActionDefs.h).
		kDisableIfLowMem,				// Enabling type (see ActionDefs.h).
		kInvalidInterfaceID,			// Selection InterfaceID this action cares about or kInvalidInterfaceID.
		kSDKDefInvisibleInKBSCEditorFlag, // kSDKDefVisibleInKBSCEditorFlag or kSDKDefInvisibleInKBSCEditorFlag.

		kHttpLinkUIActionComponentBoss,
		kHttpLinkUIRelinkFromWebActionID,
		kHttpLinkUIRelinkFromWebMenuKey,
		kPaletteMenusLinksSelectionActionArea,
		kNormalAction,
		kCustomEnabling,
		kInvalidInterfaceID,
		kSDKDefVisibleInKBSCEditorFlag,

		kHttpLinkUIActionComponentBoss,
		kHttpLinkUIPopupAboutThisActionID,
		kSDKDefAboutThisPlugInMenuKey,	// Key to the name of this action
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

        
	}
};


